// The range operators produce the range types the core library declares,
// which a for loop iterates and which compare as they do on .NET.
//
// The range types are not yet constructed by the wasm target, so calling
// total and same records the diagnostics that say so until they are.
total() -> int is
    let sum mut = 0

    for i in 0..10 do
        sum = sum + i
    od

    for i in 1::3 do
        sum = sum - i
    od

    return sum
si

same(a: Ghul.INT_RANGE, b: Ghul.INT_RANGE) -> bool => a =~ b

entry() is
    let ok = total() == 49 /\ same(0..3, 0..3)
si
