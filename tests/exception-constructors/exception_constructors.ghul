// An exception constructed with no message, and a subclass that passes
// none on.
use IO.Std.write_line

class QUIET: Ghul.Exception is
    init() is
        super.init()
    si
si

entry() is
    try
        throw QUIET()
    catch e: Ghul.Exception
        write_line(e.message)
    yrt

    try
        throw Ghul.NotImplementedException()
    catch e: Ghul.NotImplementedException
        write_line(e.message)
    yrt
si
