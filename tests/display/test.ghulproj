<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <AssemblyName>binary</AssemblyName>
    <GhulOptions>--target wasm</GhulOptions>
    <GhulNoWarn>assembly-attribute-unmatched</GhulNoWarn>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="**/*.ghul" />
    <GhulSources Include="../../src/**/*.ghul" />
  </ItemGroup>
</Project>
