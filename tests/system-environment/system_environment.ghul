// System.Environment reads a variable as .NET does, gives no executable path
// on wasm, and ends the process with the status passed to exit, after the
// output written before it.
entry() -> int is
    IO.Std.write_line(if System.Environment.get_environment_variable("PATH")? then "PATH is set" else "PATH is not set" fi)
    IO.Std.write_line(System.Environment.get_environment_variable("GHUL_TEST_UNSET") ?? "absent")
    IO.Std.write_line(System.Environment.process_path ?? "no path")
    IO.Std.write("written before exit")

    System.Environment.exit(3)

    IO.Std.write_line("not reached")

    return 0
si
