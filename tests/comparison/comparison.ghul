// The built-in scalar types compare through =~ and the relational
// operators, as they do on .NET.
//
// Decimals are not yet compiled for the wasm target, so calling f records
// the diagnostics that say so until they are.
f(a: byte, b: ubyte, c: ulong, d: double, e: char, g: decimal, h: bool) -> bool =>
    a =~ a /\ b < b /\ c >= c /\ d =~ d /\ e <> e == 0 /\ g < g /\ h =~ h /\ h < h

entry() is
    let _ = f(1b, 2ub, 3ul, 4.5, 'c', 6.5m, true)
si
