namespace Text is
    /// Accumulates text a piece at a time, as an interpolated string does.
    class STRING_BUILDER is
        // What has been built is `_chunks` in order, then `_text`. Text is
        // joined onto `_text` while that stays short, so a builder made of a
        // few pieces never allocates a list; a longer piece, or a `_text` that
        // would grow past the limit, is moved to `_chunks` instead, so that
        // appending costs the same however much has been built. `to_string`
        // joins the chunks once, pairwise, rather than copying what is built
        // for every append.
        _text: string?
        _chunks: Collections.LIST[string]?
        _length: int

        init() is si

        /// Appends `text` to the text built so far, and returns this builder.
        ///
        /// - text: the text to append
        append(text: string) -> STRING_BUILDER is
            let tail_length = if let tail = _text then tail.length else 0 fi

            if tail_length + text.length <= _TAIL_LIMIT then
                _text = _string_concat(_text, text)
            else
                if !_chunks? then
                    _chunks = Collections.LIST[string]()
                fi

                if _text? then
                    _chunks.add(_text)
                fi

                _chunks.add(text)
                _text = null
            fi

            _length = _length + text.length

            return self
        si

        /// Appends `value`, and returns this builder.
        ///
        /// - value: the code unit to append
        append(value: char) -> STRING_BUILDER => append(_string_from_char(value))

        /// Appends `count` copies of `value`, and returns this builder.
        ///
        /// - value: the code unit to append
        /// - count: how many copies to append
        append(value: char, count: int) -> STRING_BUILDER is
            let i mut = 0

            while i < count do
                append(value)
                i = i + 1
            od

            return self
        si

        /// Appends the text of `value`, and returns this builder.
        ///
        /// - value: the value to append
        append(value: int) -> STRING_BUILDER => append(value.to_string())

        /// Appends the text of `value`, and returns this builder.
        ///
        /// - value: the value to append
        append(value: long) -> STRING_BUILDER => append(value.to_string())

        /// Appends the text of `value`, and returns this builder.
        ///
        /// - value: the value to append
        append(value: double) -> STRING_BUILDER => append(value.to_string())

        /// Appends `True` or `False`, as .NET writes a `bool`, and returns this
        /// builder.
        ///
        /// - value: the value to append
        append(value: bool) -> STRING_BUILDER => append(if value then "True" else "False" fi)

        /// Appends the text of `value`, nothing where it is absent, and
        /// returns this builder.
        ///
        /// - value: the value to append
        append(value: object?) -> STRING_BUILDER =>
            if value? then append(value.to_string()) else self fi

        /// Appends a line break, and returns this builder.
        append_line() -> STRING_BUILDER => append("\n")

        /// Appends `text` and a line break, and returns this builder.
        ///
        /// - text: the text to append
        append_line(text: string) -> STRING_BUILDER => append(text).append("\n")

        /// The number of code units built so far.
        length: int => _length

        /// The code unit at `index`, which can be replaced.
        ///
        /// - index: the position of the code unit, from 0
        [index: int]: char => to_string()[index],
            = value is
                let text = to_string()

                if index < 0 \/ index >= text.length then
                    throw Ghul.ArgumentOutOfRangeException("index");
                fi

                _replace(_string_concat(_string_concat(text.substring(0, index), _string_from_char(value)), text.substring(index + 1)))
            si

        /// Removes everything built so far, and returns this builder.
        clear() -> STRING_BUILDER is
            _text = null
            _chunks = null
            _length = 0
            return self
        si

        /// Inserts `value` at `index`, and returns this builder.
        ///
        /// - index: where to insert, from 0 to `length`
        /// - value: the text to insert
        insert(index: int, value: string) -> STRING_BUILDER is
            let text = to_string()

            _replace(_string_concat(_string_concat(text.substring(0, index), value), text.substring(index)))
            return self
        si

        /// Inserts `value` at `index`, and returns this builder.
        ///
        /// - index: where to insert, from 0 to `length`
        /// - value: the code unit to insert
        insert(index: int, value: char) -> STRING_BUILDER => insert(index, _string_from_char(value))

        /// Removes `count` code units from `start`, and returns this builder.
        ///
        /// - start: where to start removing
        /// - count: how many code units to remove
        remove(start: int, count: int) -> STRING_BUILDER is
            let text = to_string()

            _replace(_string_concat(text.substring(0, start), text.substring(start + count)))
            return self
        si

        // Appends `text` padded with spaces to `alignment` characters: on the
        // left when it is positive, on the right when it is negative. An
        // interpolated value with an alignment is appended this way.
        _append_aligned(text: string, alignment: int) is
            let width = if alignment < 0 then -alignment else alignment fi
            let padding mut = ""
            let i mut = text.length

            while i < width do
                padding = _string_concat(padding, " ")
                i = i + 1
            od

            if alignment < 0 then
                append(text)
                append(padding)
            else
                append(padding)
                append(text)
            fi
        si

        /// The text built so far.
        to_string() -> string is
            if _chunks? then
                if _text? then
                    _chunks.add(_text)
                fi

                _text = Ghul.Internal.STRING_JOINER.join(_chunks)
                _chunks = null
            fi

            return _string_concat(_text, "")
        si

        _TAIL_LIMIT: int static => 128

        // Makes `text` all there is.
        _replace(text: string) is
            _text = text
            _chunks = null
            _length = text.length
        si
    si
si
