namespace Text is
    /// Accumulates the text of an interpolated string, a piece at a time.
    class STRING_BUILDER is
        _text: string?

        init() is si

        /// Appends `text` to the text built so far.
        ///
        /// - text: the text to append
        append(text: string) is
            _text = _string_concat(_text, text)
        si

        // Appends `text` padded with spaces to `alignment` characters: on the
        // left when it is positive, on the right when it is negative. An
        // interpolated value with an alignment is appended this way.
        _append_aligned(text: string, alignment: int) is
            let width = if alignment < 0 then -alignment else alignment fi
            let padding mut = ""
            let i mut = text.length

            while i < width do
                padding = _string_concat(padding, " ")
                i = i + 1
            od

            if alignment < 0 then
                append(text)
                append(padding)
            else
                append(padding)
                append(text)
            fi
        si

        /// The text built so far.
        to_string() -> string => _string_concat(_text, "")
    si
si
