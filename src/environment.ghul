namespace Ghul is
    use Collections.Iterable
    use Collections.Iterator
    use Collections.KEY_VALUE_PAIR
    use Collections.LIST
    use Collections.MAP
    use Collections.Map

    /// A live view of a string-keyed environment: reading a key that isn't set gives an absent value, and writing null removes the key.
    trait Environment: Iterable[KEY_VALUE_PAIR[string, string]] is
        /// Reads or writes the value for `key`, absent if it isn't set.
        [key: string]: string?, = value

        /// Whether `key` is currently set.
        contains_key(key: string) -> bool

        /// Removes `key`, and returns whether it was set.
        remove(key: string) -> bool

        /// The keys currently set.
        keys: Iterable[string]

        /// The values of the keys currently set.
        values: Iterable[string]

        /// A snapshot of every key and value, as an ordinary `Map`.
        to_map() -> Map[string, string]
    si

    /// The program's environment, as the host gave it when the program
    /// started, and its command-line arguments. A write changes what the
    /// program reads afterwards; nothing outside the program sees it.
    class ENVIRONMENT: Environment is
        _instance: ENVIRONMENT static

        init() static is
            _instance = ENVIRONMENT()
        si

        // The variables' names and values, at the same positions. Kept as two
        // lists rather than a map, since an environment is small and a map
        // of strings to strings cannot yet be compiled for the wasm target.
        _names: LIST[string]
        _values: LIST[string]

        init() is
            _names = LIST[string]()
            _values = LIST[string]()

            let count = _environment_count()
            let i mut = 0

            while i < count do
                let name = _environment_name(i)

                if let value = _environment_lookup(name) then
                    _names.add(name)
                    _values.add(value)
                fi

                i = i + 1
            od
        si

        /// The program's environment.
        instance: ENVIRONMENT static => _instance

        /// The program's command-line arguments, in order.
        arguments: string[] static is
            let count = _argument_count()
            let result = Ghul._array_new[string](count)
            let i mut = 0

            while i < count do
                Ghul._array_set(result, i, _argument(i))
                i = i + 1
            od

            return result
        si

        /// Reads or writes `key`; writing null removes it.
        [key: string]: string? =>
            _get(key),
            = value is
                if let present = value then
                    let index = _names.index_of(key)

                    if index >= 0 then
                        _values[index] = present
                    else
                        _names.add(key)
                        _values.add(present)
                    fi
                else
                    remove(key)
                fi
            si

        /// Whether `key` is set.
        contains_key(key: string) -> bool => _names.contains(key)

        /// Removes `key`, and returns whether it was set.
        remove(key: string) -> bool is
            let index = _names.index_of(key)

            if index < 0 then
                return false
            fi

            _names.remove_at(index)
            _values.remove_at(index)

            return true
        si

        /// The keys set.
        keys: Iterable[string] => _names.to_array()

        /// The values of the keys set.
        values: Iterable[string] => _values.to_array()

        /// A snapshot of every key and value.
        to_map() -> Map[string, string] => MAP[string, string](_pairs())

        /// An iterator over the keys and values set.
        iterator: Iterator[KEY_VALUE_PAIR[string, string]] => _pairs().iterator

        _pairs() -> LIST[KEY_VALUE_PAIR[string, string]] is
            let result = LIST[KEY_VALUE_PAIR[string, string]]()
            let i mut = 0

            while i < _names.count do
                result.add(KEY_VALUE_PAIR[string, string](_names[i], _values[i]))
                i = i + 1
            od

            return result
        si

        _get(key: string) -> string? is
            let index = _names.index_of(key)

            if index >= 0 then
                return _values[index]
            fi

            return null
        si

        @intrinsic("host.argument_count")
        _argument_count() -> int static

        @intrinsic("host.argument")
        _argument(index: int) -> string static

        @intrinsic("host.environment_count")
        _environment_count() -> int static

        @intrinsic("host.environment_name")
        _environment_name(index: int) -> string static

        @intrinsic("host.environment_lookup")
        _environment_lookup(name: string) -> string? static
    si
si
