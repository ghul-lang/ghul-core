namespace Ghul is
    partial string is
        /// The number of UTF-16 code units the string holds.
        length: int => _string_length(self)

        /// The UTF-16 code unit at `index`.
        ///
        /// - index: the position of the code unit, from 0
        [index: int]: char => _string_char_at(self, index)
    si

    @intrinsic("string.length")
    _string_length(text: string) -> int pure

    @intrinsic("string.char_at")
    _string_char_at(text: string, index: int) -> char pure

    @intrinsic("string.concat")
    _string_concat(left: string?, right: string?) -> string pure

    @intrinsic("string.from_char")
    _string_from_char(unit: char) -> string pure
si
