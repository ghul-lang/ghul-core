namespace Ghul is
    /// A source of pseudo-random numbers. The sequence a seed produces is
    /// fixed, but it is not the sequence .NET's `System.Random` produces.
    class RANDOM is
        _s0: ulong
        _s1: ulong
        _s2: ulong
        _s3: ulong

        /// A generator seeded from the host's random source.
        init() is
            _seed((cast ulong(_random_u32()) << 32) | cast ulong(cast uint(_random_u32())))
        si

        /// A generator whose sequence is fixed by `seed`.
        ///
        /// - seed: the value the sequence is derived from
        init(seed: int) is
            _seed(cast ulong(cast long(seed)))
        si

        /// A non-negative integer less than `int.max_value`.
        next() -> int => cast int(_next_u64() >> 33)

        /// A non-negative integer less than `max`.
        ///
        /// - max: the exclusive upper bound; must not be negative
        next(max: int) -> int is
            if max < 0 then
                throw ArgumentOutOfRangeException("max")
            fi

            return cast int(((_next_u64() >> 32) * cast ulong(max)) >> 32)
        si

        /// An integer at least `min` and less than `max`.
        ///
        /// - min: the inclusive lower bound
        /// - max: the exclusive upper bound; must not be less than `min`
        next(min: int, max: int) -> int is
            if max < min then
                throw ArgumentOutOfRangeException("min")
            fi

            let range = cast ulong(cast long(max) - cast long(min))

            return cast int(cast long(min) + cast long(((_next_u64() >> 32) * range) >> 32))
        si

        /// A non-negative long integer less than `long.max_value`.
        next_int64() -> long => cast long(_next_u64() >> 1)

        /// A non-negative long integer less than `max`.
        ///
        /// - max: the exclusive upper bound; must not be negative
        next_int64(max: long) -> long is
            if max < 0L then
                throw ArgumentOutOfRangeException("max")
            fi

            if max == 0L then
                return 0L
            fi

            return cast long(_next_u64() % cast ulong(max))
        si

        /// A long integer at least `min` and less than `max`.
        ///
        /// - min: the inclusive lower bound
        /// - max: the exclusive upper bound; must not be less than `min`
        next_int64(min: long, max: long) -> long is
            if max < min then
                throw ArgumentOutOfRangeException("min")
            fi

            let range = cast ulong(max) - cast ulong(min)

            if range == 0UL then
                return min
            fi

            return cast long(cast ulong(min) + _next_u64() % range)
        si

        /// A value at least 0.0 and less than 1.0.
        next_double() -> double => cast double(_next_u64() >> 11) * 1.1102230246251565e-16

        // splitmix64 spreads a single seed over the four words of state,
        // so no seed leaves the state all zero.
        _seed(seed: ulong) is
            let state mut = seed

            state = state + 0x9E3779B97F4A7C15UL
            _s0 = _mix(state)
            state = state + 0x9E3779B97F4A7C15UL
            _s1 = _mix(state)
            state = state + 0x9E3779B97F4A7C15UL
            _s2 = _mix(state)
            state = state + 0x9E3779B97F4A7C15UL
            _s3 = _mix(state)
        si

        _mix(value: ulong) -> ulong static is
            let z mut = value

            z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL
            z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL

            return z ^ (z >> 31)
        si

        // xoshiro256**.
        _next_u64() -> ulong is
            let result = _rotate_left(_s1 * 5UL, 7) * 9UL
            let t = _s1 << 17

            _s2 = _s2 ^ _s0
            _s3 = _s3 ^ _s1
            _s1 = _s1 ^ _s2
            _s0 = _s0 ^ _s3
            _s2 = _s2 ^ t
            _s3 = _rotate_left(_s3, 45)

            return result
        si

        _rotate_left(value: ulong, count: int) -> ulong static => (value << count) | (value >> (64 - count))

        @intrinsic("host.random_u32")
        _random_u32() -> int static
    si
si
