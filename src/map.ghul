namespace Collections is
    /// Thrown on reading a key a map does not have.
    class KeyNotFoundException: Ghul.Exception is
        /// - message: what was not found
        init(message: string) is
            super.init(message);
        si
    si

    /// A map from keys to values, held in a hash table over the keys' `=~`
    /// and `get_hash_code`. Iterates its entries in the order they were
    /// added while none has been removed.
    class MAP[K, V]: Map[K, V], MutableMap[K, V] is
        // Each bucket holds one more than the index of the first entry in
        // its chain, or zero when empty; `_next` links a chain the same way.
        // A removed entry's hash is -1, and it heads the free list.
        _buckets: int[];
        _hashes: int[];
        _next: int[];
        _keys: K[];
        _values: V[];
        _used: int;
        _count: int;
        _free: int;

        /// An empty map.
        init() is
            _allocate(4);
        si

        /// An empty map with room for `capacity` entries before it grows.
        ///
        /// - capacity: the number of entries to make room for
        init(capacity: int) is
            if capacity < 0 then
                throw Ghul.ArgumentOutOfRangeException("capacity");
            fi

            _allocate(if capacity < 4 then 4 else capacity fi);
        si

        /// A map holding the entries of `source`; throws if a key appears
        /// twice.
        ///
        /// - source: the entries to copy
        init(source: Iterable[KEY_VALUE_PAIR[K, V]]) is
            _allocate(4);
            _add_all(source);
        si

        /// The number of entries.
        count: int => _count;

        /// The value `key` maps to; throws if the map has no such key.
        /// Assigning adds the key or replaces its value.
        [key: K]: V => _get(key),
            = value is
                _store(key, value, true);
            si

        /// Adds `key` mapping to `value`; throws if the map already has
        /// `key`.
        ///
        /// - key: the key to add
        /// - value: the value it maps to
        add(key: K, value: V) is
            if !_store(key, value, false) then
                throw Ghul.ArgumentException("an entry with the same key is already in the map");
            fi
        si

        /// Adds `pair`'s key mapping to its value; throws if the map already
        /// has the key.
        ///
        /// - pair: the entry to add
        add(pair: KEY_VALUE_PAIR[K, V]) is
            add(pair.key, pair.value);
        si

        /// Adds `key` mapping to `value` unless the map already has `key`,
        /// answering whether it was added.
        ///
        /// - key: the key to add
        /// - value: the value it maps to
        try_add(key: K, value: V) -> bool => _store(key, value, false);

        /// Removes `key`, answering whether the map had it.
        ///
        /// - key: the key to remove
        remove(key: K) -> bool is
            let hash = _hash(key);
            let bucket = hash % _buckets.count;
            let previous mut = -1;
            let entry mut = _buckets[bucket] - 1;

            while entry >= 0 do
                if _hashes[entry] == hash /\ _keys[entry] =~ key then
                    if previous < 0 then
                        Ghul._array_set(_buckets, bucket, _next[entry]);
                    else
                        Ghul._array_set(_next, previous, _next[entry]);
                    fi

                    Ghul._array_set(_hashes, entry, -1);
                    Ghul._array_set(_keys, entry, _[K]);
                    Ghul._array_set(_values, entry, _[V]);
                    Ghul._array_set(_next, entry, _free);

                    _free = entry + 1;
                    _count = _count - 1;

                    return true;
                fi

                previous = entry;
                entry = _next[entry] - 1;
            od

            return false;
        si

        /// Whether the map has `key`.
        ///
        /// - key: the key to look for
        contains_key(key: K) -> bool => _find(key) >= 0;

        /// Writes the value `key` maps to into `value`, answering whether
        /// the map has `key`; `value` is set to the default of `V` when it
        /// does not.
        ///
        /// - key: the key to look for
        /// - value: where the value goes
        try_get_value(key: K, value: V ref) -> bool is
            let entry = _find(key);

            if entry < 0 then
                value! = _[V];

                return false;
            fi

            value! = _values[entry];

            return true;
        si

        /// Whether any key maps to `value`.
        ///
        /// - value: the value to look for
        contains_value(value: V) -> bool is
            let i mut = 0;

            while i < _used do
                if _hashes[i] >= 0 /\ _values[i] =~ value then
                    return true;
                fi

                i = i + 1;
            od

            return false;
        si

        /// Removes every entry.
        clear() is
            _allocate(4);
        si

        /// The keys, in the order the entries are iterated.
        keys: Iterable[K] is
            let result = Ghul._array_new[K](_count);
            let i mut = 0;
            let j mut = 0;

            while i < _used do
                if _hashes[i] >= 0 then
                    Ghul._array_set(result, j, _keys[i]);
                    j = j + 1;
                fi

                i = i + 1;
            od

            return result;
        si

        /// The values, in the order the entries are iterated.
        values: Iterable[V] is
            let result = Ghul._array_new[V](_count);
            let i mut = 0;
            let j mut = 0;

            while i < _used do
                if _hashes[i] >= 0 then
                    Ghul._array_set(result, j, _values[i]);
                    j = j + 1;
                fi

                i = i + 1;
            od

            return result;
        si

        /// An iterator over the entries.
        iterator: Iterator[KEY_VALUE_PAIR[K, V]] => MAP_ITERATOR[K, V](_hashes, _keys, _values, _used);

        _allocate(size: int) is
            _buckets = Ghul._array_new[int](size);
            _hashes = Ghul._array_new[int](size);
            _next = Ghul._array_new[int](size);
            _keys = Ghul._array_new[K](size);
            _values = Ghul._array_new[V](size);
            _used = 0;
            _count = 0;
            _free = 0;
        si

        _get(key: K) -> V is
            let entry = _find(key);

            if entry < 0 then
                throw KeyNotFoundException("the key is not in the map");
            fi

            return _values[entry];
        si

        _add_all(source: Iterable[KEY_VALUE_PAIR[K, V]]) is
            for pair in source do
                add(pair.key, pair.value);
            od
        si

        _hash(key: K) -> int => key.get_hash_code() & 0x7FFF_FFFF;

        _find(key: K) -> int is
            let hash = _hash(key);
            let entry mut = _buckets[hash % _buckets.count] - 1;

            while entry >= 0 do
                if _hashes[entry] == hash /\ _keys[entry] =~ key then
                    return entry;
                fi

                entry = _next[entry] - 1;
            od

            return -1;
        si

        // Stores `value` for `key`, replacing an existing value only when
        // `replace` says so, and answers whether it stored anything.
        _store(key: K, value: V, replace: bool) -> bool is
            let existing = _find(key);

            if existing >= 0 then
                if replace then
                    Ghul._array_set(_values, existing, value);
                fi

                return replace;
            fi

            let entry mut = 0;

            if _free > 0 then
                entry = _free - 1;
                _free = _next[entry];
            else
                if _used == _keys.count then
                    _grow();
                fi

                entry = _used;
                _used = _used + 1;
            fi

            let hash = _hash(key);
            let bucket = hash % _buckets.count;

            Ghul._array_set(_hashes, entry, hash);
            Ghul._array_set(_keys, entry, key);
            Ghul._array_set(_values, entry, value);
            Ghul._array_set(_next, entry, _buckets[bucket]);
            Ghul._array_set(_buckets, bucket, entry + 1);

            _count = _count + 1;

            return true;
        si

        // Doubles the table. Nothing is free when it grows, since a free
        // entry is reused before a new one is taken, so every entry below
        // `_used` is live and keeps its index.
        _grow() is
            let size = _keys.count * 2;

            let hashes = _hashes;
            let keys = _keys;
            let values = _values;
            let used = _used;

            _buckets = Ghul._array_new[int](size);
            _hashes = Ghul._array_new[int](size);
            _next = Ghul._array_new[int](size);
            _keys = Ghul._array_new[K](size);
            _values = Ghul._array_new[V](size);

            let i mut = 0;

            while i < used do
                let bucket = hashes[i] % size;

                Ghul._array_set(_hashes, i, hashes[i]);
                Ghul._array_set(_keys, i, keys[i]);
                Ghul._array_set(_values, i, values[i]);
                Ghul._array_set(_next, i, _buckets[bucket]);
                Ghul._array_set(_buckets, bucket, i + 1);

                i = i + 1;
            od
        si
    si

    /// Iterates the entries a map held when the iterator was made.
    class MAP_ITERATOR[K, V]: Iterator[KEY_VALUE_PAIR[K, V]] is
        _hashes: int[];
        _keys: K[];
        _values: V[];
        _used: int;
        _index: int;

        /// An iterator positioned before the first entry of the map's
        /// table.
        ///
        /// - hashes: each entry's hash, or -1 where the entry was removed
        /// - keys: each entry's key
        /// - values: each entry's value
        /// - used: the number of entries in use or removed
        init(hashes: int[], keys: K[], values: V[], used: int) is
            _hashes = hashes;
            _keys = keys;
            _values = values;
            _used = used;
            _index = -1;
        si

        /// Moves to the next entry, answering whether there is one.
        move_next() -> bool is
            _index = _index + 1;

            while _index < _used /\ _hashes[_index] < 0 do
                _index = _index + 1;
            od

            return _index < _used;
        si

        /// The entry the iterator is positioned at.
        current: KEY_VALUE_PAIR[K, V] => KEY_VALUE_PAIR[K, V](_keys[_index], _values[_index]);

        /// Releases nothing: a map holds no resource.
        dispose() is si
    si
si
