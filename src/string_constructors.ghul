namespace Ghul.Internal is
    /// The string constructors .NET's string declares, which the compiler
    /// offers as overloads of string's own.
    class STRING_CHAR_CONSTRUCTORS is
        /// A string holding the code units of `chars`, in order.
        ///
        /// - chars: the code units
        @intrinsic("constructor.from_chars")
        from_chars(chars: char[]) -> string static pure is
            let units = Ghul._array_new[string](chars.count)
            let i mut = 0

            while i < chars.count do
                Ghul._array_set(units, i, _string_from_char(chars[i]))
                i = i + 1
            od

            return STRING_JOINER.join(units)
        si

        /// A string holding `count` copies of `unit`.
        ///
        /// - unit: the code unit to repeat
        /// - count: how many copies, which must not be negative
        @intrinsic("constructor.from_repeated")
        from_repeated(unit: char, count: int) -> string static pure is
            if count < 0 then
                throw Ghul.ArgumentOutOfRangeException("count", "the count must not be negative")
            fi

            return Text.STRING_BUILDER().append(unit, count).to_string()
        si
    si

    /// Joins strings end to end without copying the same characters over and
    /// over.
    class STRING_JOINER is
        /// The strings of `parts` joined end to end, in order.
        ///
        /// - parts: the strings to join
        join(parts: Collections.LIST[string]) -> string static is
            let pieces = Ghul._array_new[string](parts.count)
            let i mut = 0

            while i < parts.count do
                Ghul._array_set(pieces, i, parts[i])
                i = i + 1
            od

            return join(pieces)
        si

        /// The strings of `parts` joined end to end, in order. `parts` is used
        /// as working space and is not left as it was.
        ///
        /// - parts: the strings to join
        join(parts: string[]) -> string static is
            let count mut = parts.count

            if count == 0 then
                return ""
            fi

            while count > 1 do
                let from mut = 0
                let to mut = 0

                while from + 1 < count do
                    Ghul._array_set(parts, to, _string_concat(parts[from], parts[from + 1]))
                    from = from + 2
                    to = to + 1
                od

                if from < count then
                    Ghul._array_set(parts, to, parts[from])
                    to = to + 1
                fi

                count = to
            od

            return parts[0]
        si
    si
si
