            return wide.to_string()
        si
    si

    partial ulong is
        /// The value in decimal.
        to_string() -> string is
            if self == 0UL then
                return "0"
            fi

            let text mut = ""
            let rest mut = self

            while !(rest == 0UL) do
                let digit = cast int(rest % 10UL)

                text = _string_concat(_string_from_char(cast char(48 + digit)), text)
                rest = rest / 10UL
            od

            return text
        si
    si

    partial long is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string is
            if self == 0L then
                return "0"
            fi

            let text mut = ""
            let rest mut = self

            // The digits come out lowest first. A negative value's
            // remainders are negative too, so each is turned to its
            // magnitude rather than the value as a whole, which has no
            // positive counterpart at its minimum.
            while !(rest == 0L) do
                let digit mut = cast int(rest % 10L)

                if digit < 0 then
                    digit = -digit
                fi

                text = _string_concat(_string_from_char(cast char(48 + digit)), text)
                rest = rest / 10L
            od

            if self < 0L then
                text = _string_concat("-", text)
            fi

            return text
        si
    si

    partial double is
        /// The shortest text that reads back as the same value, as .NET
        /// writes it in the invariant culture.
        to_string() -> string => _format_double(self)
    si

    partial single is
        /// The shortest text that reads back as the same value, as .NET
        /// writes it in the invariant culture.
        to_string() -> string => _format_single(self)
    si

    // The text of each numeric type under a .NET numeric format string, as
    // .NET writes it in the invariant culture: the standard formats `D`,
    // `E`, `F`, `G`, `N`, `R` and `X` with an optional precision, and custom
    // patterns of `0`, `#`, `.` and `,`.

    partial byte is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_signed_as(cast long(self), format, 8)
    si

    partial short is
        /// The value written under the numeric format string `format`.
