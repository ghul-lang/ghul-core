namespace Ghul is
    partial char is
        /// The string holding just this UTF-16 code unit.
        to_string() -> string => _string_from_char(self)
    si

    partial int is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial long is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string is
            if self == 0L then
                return "0"
            fi

            let text mut = ""
            let rest mut = self

            // The digits come out lowest first. A negative value's
            // remainders are negative too, so each is turned to its
            // magnitude rather than the value as a whole, which has no
            // positive counterpart at its minimum.
            while !(rest == 0L) do
                let digit mut = cast int(rest % 10L)

                if digit < 0 then
                    digit = -digit
                fi

                text = _string_concat(_string_from_char(cast char(48 + digit)), text)
                rest = rest / 10L
            od

            if self < 0L then
                text = _string_concat("-", text)
            fi

            return text
        si
    si

    partial double is
        /// The shortest text that reads back as the same value, as .NET
        /// writes it in the invariant culture.
        to_string() -> string => _format_double(self)
    si

    partial single is
        /// The shortest text that reads back as the same value, as .NET
        /// writes it in the invariant culture.
        to_string() -> string => _format_single(self)
    si

    // The IEEE 754 bits of `value`.
    @intrinsic("double.bits")
    _double_bits(value: double) -> ulong pure

    // The IEEE 754 bits of `value`.
    @intrinsic("single.bits")
    _single_bits(value: single) -> uint pure
si
